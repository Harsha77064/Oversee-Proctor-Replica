# ---------------------------------------------------------------------------
# Oversee configuration. Copy to .env and fill in.
# ---------------------------------------------------------------------------

# --- Production (docker compose) ---
# Your domain, already pointing (DNS A record) at this server.
DOMAIN=exams.example.com
# Email for Let's Encrypt certificate notices (optional but recommended).
ACME_EMAIL=you@example.com
# Long random secret shared by the app and the TURN relay.
# Generate one with:  openssl rand -hex 32
TURN_SECRET=change-me-to-a-long-random-string

# --- Email invitations (optional) ---
# Easiest: set this up in the app under Settings -> Email (with a test mode).
# If SMTP_HOST and SMTP_FROM are set here, they override the app's Email settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Oversee Exams <exams@example.com>"

# --- Other options (defaults shown) ---
# SESSION_HOURS=12          # staff sign-in lifetime
# INVITE_VALID_DAYS=14      # how long an exam invitation link works
# MAX_RECORDING_MB=1024     # largest recording upload

# --- Local development only (npm run dev / python -m server without Docker) ---
# PORT=3001
# DATA_DIR=data
# PUBLIC_URL=http://localhost:5173
